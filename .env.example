# Copy this file to .env.local and fill in the values.
# Never commit a populated .env or .env.local — both are gitignored.

# ─── Database ─────────────────────────────────────────────────────────────────
# Production: Neon Postgres connection string.
# Local dev: spin up via `docker compose up -d` then use the connection string below.
DATABASE_URL="postgresql://sentinel:sentinel_dev@localhost:5432/sentinel_db?schema=public"

# Test database — point at a separate Neon branch or Postgres instance.
# Tests will refuse to run without this. See TESTING.md.
TEST_DATABASE_URL="postgresql://sentinel:sentinel_dev@localhost:5432/sentinel_test?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Email (magic-link sign-in + admin notifications) ─────────────────────────
# SendGrid API key — https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY="SG.xxxxx"
EMAIL_FROM="no-reply@yourdomain.com"
ADMIN_EMAIL="you@yourdomain.com"
# NextAuth still requires this even though we override sendVerificationRequest.
# A bogus SMTP URL is fine since SendGrid handles real delivery.
EMAIL_SERVER="smtp://localhost"

# ─── AI (Clove) ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-xxxxx"

# ─── Rate limiting (Upstash Redis) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-rest-token"

# ─── Web Push notifications ───────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# The public key is exposed to the browser via NEXT_PUBLIC_; keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
