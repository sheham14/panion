{
  "name": "project-sentinel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "// build": "prisma generate is explicit: Prisma 7 dropped @prisma/client's postinstall auto-generate, and prisma/generated is gitignored, so a fresh checkout (Vercel) has no client without this. NOTE: do not run this while `npm run dev` is live — it overwrites .next underneath the dev server and newly-added routes start returning Next's HTML 404.",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:setup": "tsx tests/helpers/setup-test-db.ts",
    "seed": "tsx prisma/seed.ts",
    "scrape:flipp": "tsx scripts/scrape-flipp.ts",
    "scrape:dominion": "tsx scripts/scrape-pcexpress.ts",
    "scrape:sobeys": "tsx scripts/scrape-voila.ts",
    "catalogue:import": "tsx scripts/import-catalogue.ts",
    "snapshot:save": "tsx scripts/snapshot.ts save",
    "snapshot:restore": "tsx scripts/snapshot.ts restore",
    "coverage": "tsx scripts/coverage.ts",
    "prices:clean": "tsx scripts/clear-bad-prices.ts",
    "role": "tsx scripts/grant-role.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/nextjs": "^10.47.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "inngest": "^4.2.0",
    "lucide-react": "^1.8.0",
    "next": "^16.2.2",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "react": "^18",
    "react-dom": "^18",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.2",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.7",
    "vitest-mock-extended": "^4.0.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
